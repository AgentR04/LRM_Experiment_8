# Copy to .env and fill in (optional - everything works without it in extractive mode)

# LLM_PROVIDER: auto (default) | gemini | ollama | openai | none
LLM_PROVIDER=auto

# Option A - Google Gemini (key from https://aistudio.google.com/apikey)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.8-flash

# Option B - fully local: install https://ollama.com then:
#   ollama pull llama3.1
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Option C - any OpenAI-compatible API (OpenAI, Groq, OpenRouter, LM Studio...)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Embedding model override
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
